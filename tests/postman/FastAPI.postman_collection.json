		{
			"name": "Register",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomNumber = Math.floor(Math.random() * 1000000);",
							"const email = `test${randomNumber}@example.com`;",
							"",
							"pm.collectionVariables.set(\"email\", email);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();",
							"",
							"pm.test(\"User created correctly\", function () {",
							"    pm.response.to.have.status(200);",
							"    pm.expect(json.email).to.eql(pm.collectionVariables.get(\"email\"));",
							"    pm.expect(json).to.have.property(\"id\");",
							"    pm.expect(json.is_active).to.be.true;",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password\"\n}\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{localhost}}/auth/register",
					"host": [
						"{{localhost}}"
					],
					"path": [
						"auth",
						"register"
					]
				}
			},
			"response": []
