		{
			"name": "Video-info",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();",
							"",
							"pm.test(\"Video data valid\", () => {",
							"    pm.response.to.have.status(200);",
							"",
							"    pm.expect(json.id).to.be.a(\"string\");",
							"    pm.expect(json.canonical_url).to.include(\"youtube.com/watch\");",
							"    pm.expect(json.title).to.be.a(\"string\");",
							"    pm.expect(json.thumbnail_url).to.include(\"img.youtube.com\");",
							"    pm.expect(json.created_at).to.be.a(\"string\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function randomYouTubeId(length = 11) {",
							"    const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\";",
							"    let result = \"\";",
							"    ",
							"    for (let i = 0; i < length; i++) {",
							"        result += chars.charAt(Math.floor(Math.random() * chars.length));",
							"    }",
							"    ",
							"    return result;",
							"}",
							"",
							"const videoId = randomYouTubeId();",
							"const sourceUrl = `https://www.youtube.com/watch?v=${videoId}`;",
							"",
							"pm.collectionVariables.set(\"video_id\", videoId);",
							"pm.collectionVariables.set(\"source_url\", sourceUrl);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"source_url\": \"{{source_url}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{localhost}}/video/video-info",
					"host": [
						"{{localhost}}"
					],
					"path": [
						"video",
						"video-info"
					]
				}
			},
			"response": []
		},
